{
  "name": "OmniMind Vision OS",
  "short_name": "OmniMind",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#030712",
  "theme_color": "#0ea5e9",
  "description": "Multimodal AI Analysis Engine",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url",
      "files": [
        {
          "name": "shared_image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
